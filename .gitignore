# ==========================================================
#  四轴无人机项目 · .gitignore
#  原则：只提交「人和工具写出来的东西」（源码、工程配置、文档、原理图），
#        不提交「编译出来的东西」（.o / .axf / .hex / 日志）。
#  CubeMX 重新生成代码 + Keil 重新编译，就能把这些产物原样造出来。
# ==========================================================

# ---------- Keil MDK 的编译输出目录（整个目录都是产物） ----------
MDK-ARM/P01_flight_hal/

# ---------- Keil 单文件产物（防止输出目录改名后漏网） ----------
*.o
*.d
*.crf
*.dep
*.axf
*.elf
*.hex
*.bin
*.map
*.lst
*.lnp
*.sct
*.htm
*.build_log.htm
*.iex
*.tra
*.bak

# ---------- Keil 与本机绑定的个人配置（换台电脑就没用了） ----------
*.uvguix.*
*.uvoptx

# ---------- VS Code / Keil Assistant 的临时日志与锁文件 ----------
*.log
*.lock
.vscode/ipch/

# ---------- Windows / 编辑器垃圾文件 ----------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~

# ---------- AI 助手的工作目录（不属于项目产出） ----------
DeepSeek Harness/
